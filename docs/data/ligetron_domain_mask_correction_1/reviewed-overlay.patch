+// Modular Reduction
+// --------------------------------------------------
+fn bn254fr_reduce(a : bigint) -> bigint {
+    let res : bigint_cc = bigint_sub_cc(a, BN254_p);
+    if (res.carry) {  // a < p
+        return a;
+    }
+    else {
+        return res.sum;
+    }
+}
+
+fn bn254fr_reduce_2p(a : bigint) -> bigint {
+    let res : bigint_cc = bigint_sub_cc(a, BN254_2p);
+    if (res.carry) { // a < 2p
+        return a;
+    }
+    else {
+        return res.sum;
+    }
+}
