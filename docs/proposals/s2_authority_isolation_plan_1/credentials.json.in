{
  "proposal_only": true,
  "live_secrets": false,
  "owner_sources": {
    "m": "/etc/pqiso/credentials/owner-m.bin",
    "i": "/etc/pqiso/credentials/owner-i.bin",
    "va": "/etc/pqiso/credentials/owner-va.bin",
    "vb": "/etc/pqiso/credentials/owner-vb.bin"
  },
  "client_sources": {
    "pqiso-w-m": "/etc/pqiso/credentials/client-pqiso-w-m.bin",
    "pqiso-w-i": "/etc/pqiso/credentials/client-pqiso-w-i.bin",
    "pqiso-w-va": "/etc/pqiso/credentials/client-pqiso-w-va.bin",
    "pqiso-w-vb": "/etc/pqiso/credentials/client-pqiso-w-vb.bin",
    "pqiso-admin": "/etc/pqiso/credentials/client-pqiso-admin.bin",
    "pqiso-observer": "/etc/pqiso/credentials/client-pqiso-observer.bin",
    "pqiso-rec-a": "/etc/pqiso/credentials/client-pqiso-rec-a.bin",
    "pqiso-rec-b": "/etc/pqiso/credentials/client-pqiso-rec-b.bin",
    "pqiso-denied": "/etc/pqiso/credentials/client-pqiso-denied.bin"
  },
  "owner_issuer_additional_secret": "manager issuer-bridge capability in owner-i bundle",
  "generation": "32 random bytes per logical principal per scope; generate only during separately authorised provisioning",
  "permissions": "root:root 0400 files, root:root 0700 parent; systemd LoadCredential projects read-only unit credentials",
  "replacement": "stop affected owners/clients, close old connections, replace both mappings and credential bundles atomically, restart inactive, validate exact ticket/admin generation; no live reload fallback"
}
