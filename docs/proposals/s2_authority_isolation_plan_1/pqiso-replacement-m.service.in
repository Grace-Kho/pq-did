# PROPOSAL ONLY. Missing authorised marker, launcher and adapter prevent activation.
[Unit]
Description=PQ-DID proposed manager replacement owner
ConditionPathExists=/etc/pqiso/ACTIVATION-AUTHORISED
[Service]
Type=exec
User=pqiso-o-m
Group=pqiso-o-m
Slice=pqiso.slice
CPUAffinity=0 1
Delegate=no
ProtectControlGroups=yes
UMask=0077
WorkingDirectory=/opt/pqiso/r1
LoadCredential=auth:/etc/pqiso/credentials/owner-m.bin
ExecStartPre=/usr/bin/python3.14 -I -B /opt/pqiso/r1/preflight.py owner m %d --slot replacement
ExecStart=/usr/bin/env -i PATH=/usr/bin:/bin LANG=C.UTF-8 /opt/pqiso/r1/.venv/bin/python -I -B /opt/pqiso/r1/owner_entry.py --owner m --slot replacement --policy /etc/pqiso/owners/m/policy.json --credentials-directory %d
Restart=no
RuntimeMaxSec=20
TimeoutStartSec=5
TimeoutStopSec=1
KillMode=control-group
OOMPolicy=kill
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
LockPersonality=yes
LimitCORE=0
LimitFSIZE=1048576
FileDescriptorStoreMax=0
StandardInput=null
StandardOutput=journal
StandardError=journal
ReadWritePaths=/var/lib/pqiso/stores/m /run/pqiso/m
