+// The sole experimental correction: demand-driven matrix XOF output. Rejection
+// still consumes exactly three bytes and cannot read beyond the 1026-byte budget.
+// Rate-sized fills avoid producing two unused SHAKE blocks in ordinary samples.
+trait Triples {
+    fn triple(&mut self) -> Result<&[u8]>;
+}
+struct MatrixXof<R> {
+    reader: R,
+    bytes: [u8; 1026],
+    generated: usize,
+    consumed: usize,
+}
+impl<R: XofReader> MatrixXof<R> {
+    fn new(reader: R) -> Self {
+        Self {
+            reader,
+            bytes: [0; 1026],
+            generated: 0,
+            consumed: 0,
+        }
+    }
+}
+impl<R: XofReader> Triples for MatrixXof<R> {
+    fn triple(&mut self) -> Result<&[u8]> {
+        let end = self.consumed.checked_add(3).ok_or("budget overflow")?;
+        if end > self.bytes.len() {
+            return Err("sampler exhausted");
+        }
+        if end > self.generated {
+            let next = (self.generated + 168).min(self.bytes.len());
+            self.reader.read(&mut self.bytes[self.generated..next]);
+            self.generated = next;
+        }
+        let start = self.consumed;
+        self.consumed = end;
+        Ok(&self.bytes[start..end])
+    }
