{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pqdid:oct31-milestone-1:measurement",
  "title": "Counted disclosed ML-DSA reference observation",
  "description": "Additional timing, identity, classification and null invariants are enforced by export.validate_record.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "run_id", "attempt_id", "invocation_id", "session_id", "scenario_id", "phase", "trial_index", "capability", "category", "measurement_origin", "outcome", "reason", "start_monotonic_ns", "end_monotonic_ns", "duration_ns", "stages_ns", "stage_parents", "setup_ns", "keygen_ns", "message_bytes", "identities", "fixture_sha256", "instance_sha256", "signing", "resources", "counters", "environment", "unavailable", "censoring", "details"],
  "properties": {
    "version": {"const": 1},
    "run_id": {"type": "string"},
    "attempt_id": {"type": "string"},
    "invocation_id": {"type": ["integer", "string"]},
    "session_id": {"type": "string"},
    "scenario_id": {"enum": ["ISSUE", "PRESENT-A", "PRESENT-B", "REVOKE-UPDATE"]},
    "phase": {"enum": ["cold", "warmup", "warm"]},
    "trial_index": {"type": "integer", "minimum": 0},
    "capability": {"type": "object"},
    "category": {"enum": ["mldsa_reference_measured", "reference_lifecycle", "native_component", "private_auth_unavailable"]},
    "measurement_origin": {"enum": ["actual", "synthetic-validation"]},
    "outcome": {"enum": ["accepted", "expected-rejection", "unexpected-rejection", "unexpected-acceptance", "expired", "stale-state", "resource-abort", "unavailable", "incomplete"]},
    "reason": {"type": ["string", "null"]},
    "start_monotonic_ns": {"type": "integer", "minimum": 0},
    "end_monotonic_ns": {"type": "integer", "minimum": 0},
    "duration_ns": {"type": "integer", "minimum": 0},
    "stages_ns": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "stage_parents": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
    "setup_ns": {"type": "integer", "minimum": 0},
    "keygen_ns": {"type": "integer", "minimum": 0},
    "message_bytes": {"type": "object", "additionalProperties": {"type": "object", "required": ["canonical", "transport"], "additionalProperties": false, "properties": {"canonical": {"type": "integer", "minimum": 0}, "transport": {"type": "integer", "minimum": 0}}}},
    "identities": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "fixture_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "instance_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "signing": {"type": "object"},
    "resources": {"type": "object"},
    "counters": {"type": "object", "required": ["reserved"], "properties": {"reserved": {"const": true}}},
    "environment": {"type": "object", "required": ["guard"]},
    "unavailable": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "required": ["operation", "available", "seconds", "bytes", "reason"], "additionalProperties": false, "properties": {"operation": {"enum": ["prove_auth", "verify_auth_proof"]}, "available": {"const": false}, "seconds": {"const": null}, "bytes": {"const": null}, "reason": {"const": "complete private authentication backend not implemented"}}}},
    "censoring": {"type": ["object", "null"]},
    "details": {"type": "object"}
  }
}
